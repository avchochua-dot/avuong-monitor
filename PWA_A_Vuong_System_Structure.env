# ==============================================================================
# CẤU TRÚC HỆ THỐNG PWA A VƯƠNG • DASHBOARD • AI
# ==============================================================================
# Mục đích:
# - Tài liệu hóa cấu trúc hệ thống PWA dưới dạng file ENV có chú thích.
# - Không phải tất cả biến bên dưới đều đang được đọc trực tiếp bởi index.html.
# - Các biến được chia làm 2 loại:
#   [SOURCE]      = xác nhận được từ mã nguồn PWA hiện tại.
#   [RECOMMENDED] = đề xuất để chuẩn hóa cấu hình khi tách frontend/backend.
#
# LƯU Ý BẢO MẬT:
# - Không lưu mật khẩu, service_role key, OpenWeather API key, token máy chủ
#   hạ lưu hoặc khóa bí mật trong file frontend/public.
# - SUPABASE_PUBLISHABLE_KEY là khóa public/anon dùng phía client, nhưng vẫn
#   phải kết hợp RLS/Policy chặt chẽ.
# - Các secret của backend nên cấu hình trong môi trường server/Vercel/hosting.
# ==============================================================================


# ==============================================================================
# 01. PROJECT / BUILD
# ==============================================================================

# [SOURCE] Tên hệ thống hiển thị trên giao diện.
APP_NAME="A Vương • Dashboard • AI"

# [SOURCE] Build hiện tại trong mã nguồn.
PWA_BUILD="2026-09-15-hydro-frequency-percent-fix-v19"

# [SOURCE] Ngôn ngữ giao diện.
APP_LANG="vi"

# [SOURCE] Màu nền/chủ đề chính.
APP_THEME_COLOR="#080b1a"

# [SOURCE] Giới hạn chiều rộng PWA trên desktop/tablet.
APP_MAX_WIDTH_PX="600"

# [SOURCE] Chiều cao bottom navigation.
APP_NAV_HEIGHT_PX="65"

# [SOURCE] Timezone nghiệp vụ.
APP_TIMEZONE="Asia/Ho_Chi_Minh"


# ==============================================================================
# 02. KIẾN TRÚC TỔNG THỂ
# ==============================================================================
#
# Luồng chính:
#
#   Smartphone / Browser
#          |
#          v
#   PWA Frontend (HTML + CSS + JavaScript)
#          |
#          +-----------------------------+
#          |                             |
#          v                             v
#   Supabase JS Client              Internal API /api/*
#   - Auth                          - mobile-overview
#   - PostgreSQL                    - mobile-extra
#   - Views                         - mobile-monitoring
#   - RPC                           - mobile-rain
#   - Storage                       - mobile-chat-data
#                                  - downstream-forecast
#          |                             |
#          |                             v
#          |                       Backend integration layer
#          |                       - chuẩn hóa dữ liệu
#          |                       - đồng bộ nguồn ngoài
#          |                       - trả JSON cho PWA
#          |
#          +-----------------------------+
#                        |
#                        v
#             Dashboard / Chart / Forecast
#             Data table / Maps / AI
#
# Service Worker:
# - đăng ký service-worker.js?v=<PWA_BUILD>
# - updateViaCache='none'
# - chủ động reg.update()
# - hỗ trợ SKIP_WAITING
# - reload khi controllerchange
# ==============================================================================


# ==============================================================================
# 03. FRONTEND STACK
# ==============================================================================

# [SOURCE] Ứng dụng hiện tại là PWA frontend thuần HTML/CSS/JavaScript.
FRONTEND_TYPE="Vanilla HTML/CSS/JavaScript"

# [SOURCE] Supabase JavaScript SDK.
FRONTEND_SUPABASE_JS="@supabase/supabase-js@2"

# [SOURCE] Chart library.
FRONTEND_CHART_JS="chart.js@4.4.1"

# [SOURCE] Map library.
FRONTEND_LEAFLET_JS="leaflet@1.9.4"

# [SOURCE] Font.
FRONTEND_FONT_MAIN="Inter"
FRONTEND_FONT_MONO="JetBrains Mono"

# [SOURCE] File PWA bắt buộc.
PWA_ENTRY_FILE="index.html"
PWA_MANIFEST_FILE="manifest.json"
PWA_SERVICE_WORKER_FILE="service-worker.js"
PWA_ICON_192="./icons/icon-192.png"


# ==============================================================================
# 04. PWA NAVIGATION / MODULES
# ==============================================================================

# [SOURCE] 5 tab chính ở bottom navigation.
PWA_TAB_1="overview"
PWA_TAB_1_LABEL="Tổng quan"

PWA_TAB_2="chart"
PWA_TAB_2_LABEL="Biểu đồ"

PWA_TAB_3="forecast"
PWA_TAB_3_LABEL="Dự báo"

PWA_TAB_4="data"
PWA_TAB_4_LABEL="Số liệu"

PWA_TAB_5="more"
PWA_TAB_5_LABEL="Mở rộng"

# [SOURCE] Các panel trong tab Mở rộng.
PWA_MORE_1="reservoirs"
PWA_MORE_1_LABEL="Các hồ liên quan"

PWA_MORE_2="downstream"
PWA_MORE_2_LABEL="Mực nước hạ du"

PWA_MORE_3="openmeteo"
PWA_MORE_3_LABEL="Mưa Open-Meteo"

PWA_MORE_4="openweather"
PWA_MORE_4_LABEL="Mưa OpenWeather"

PWA_MORE_5="windy"
PWA_MORE_5_LABEL="Bản đồ thời tiết Windy"

PWA_MORE_6="maps"
PWA_MORE_6_LABEL="Bản đồ ngập lụt"

PWA_MORE_7="floodmarks"
PWA_MORE_7_LABEL="Mốc lũ hạ du"

PWA_MORE_8="chat"
PWA_MORE_8_LABEL="Chatbox AI"

PWA_MORE_9="bulletins"
PWA_MORE_9_LABEL="Nhận định AI"


# ==============================================================================
# 05. SUPABASE
# ==============================================================================

# [SOURCE] URL dự án Supabase đang được frontend sử dụng.
SUPABASE_URL="https://ycthhachfxczwkburnfa.supabase.co"

# [SOURCE] Frontend hiện dùng publishable/anon key.
# Không ghi giá trị thật vào tài liệu cấu trúc.
SUPABASE_PUBLISHABLE_KEY="__REPLACE_WITH_PUBLIC_SUPABASE_KEY__"

# [SOURCE] Đăng nhập bằng Supabase Auth Email/Password.
AUTH_PROVIDER="supabase"
AUTH_METHOD="email_password"

# [SOURCE] Sau đăng nhập thành công, PWA ghi log sử dụng.
AUTH_USAGE_LOG_ENABLED="true"

# [RECOMMENDED] Service role chỉ dùng phía backend, KHÔNG đưa vào PWA.
SUPABASE_SERVICE_ROLE_KEY="__SERVER_ONLY_DO_NOT_EXPOSE__"


# ==============================================================================
# 06. DATABASE TABLES / VIEWS
# ==============================================================================

# [SOURCE]
# Dữ liệu vận hành hồ theo giờ:
# - time
# - water_level
# - inflow
# - turbine_flow
# - spillway_flow
# - rainfallreal
DB_TABLE_RESERVOIR_HOURLY="reservoir_hourly_data"

# [SOURCE]
# Dự báo lưu lượng các model RF2Q/AI.
DB_TABLE_INFLOW_FORECAST="inflow_forecast"

# [SOURCE]
# Dự báo HEC-HMS Lite production.
DB_TABLE_INFLOW_FORECAST_SQL="inflow_forecast_sql"

# [SOURCE]
# Dự báo mưa.
DB_TABLE_RAINFALL_FORECAST="rainfall_forecast"

# [SOURCE]
# View dung tích hiện tại và các trường tổng hợp hồ.
DB_VIEW_CURRENT_STORAGE="v_current_storage"

# [SOURCE]
# View lịch sử HEC-Lite backtest để ghép với cycle hiện tại.
DB_VIEW_HEC_LITE_HISTORY="v_hec_lite_chart_history"

# [SOURCE]
# Bản tin dự báo.
DB_TABLE_BULLETINS="bulletins"

# [SOURCE]
# Log người dùng đăng nhập.
DB_TABLE_USAGE_LOGS="usage_logs"

# [SOURCE]
# Nhận định AI.
DB_TABLE_AI_BULLETINS="ai_bulletins"

# [SOURCE]
# RPC tạo nhận định vận hành AI.
DB_RPC_GENERATE_AI_INSIGHT="generate_ai_operational_insight_v4"


# ==============================================================================
# 07. INTERNAL API ROUTES
# ==============================================================================

# [SOURCE]
# Tổng quan hồ chứa.
# Yêu cầu Authorization: Bearer <Supabase access_token>.
# Nếu API lỗi, code hiện có fallback về dữ liệu Supabase cũ.
API_MOBILE_OVERVIEW="/api/mobile-overview"

# [SOURCE]
# Bổ sung 2 nhóm:
# - hydrology_frequency
# - dead_level_forecast
API_MOBILE_EXTRA="/api/mobile-extra"

# [SOURCE]
# Dữ liệu monitoring dùng chung cho:
# - hồ liên quan
# - hạ du
# Query: ?hours=24|48|72
API_MOBILE_MONITORING="/api/mobile-monitoring"

# [SOURCE]
# Dữ liệu mưa theo nguồn:
# ?source=openmeteo
# ?source=openweather
API_MOBILE_RAIN="/api/mobile-rain"

# [SOURCE]
# Dữ liệu phục vụ Chatbox AI.
API_MOBILE_CHAT_DATA="/api/mobile-chat-data"

# [SOURCE]
# Đồng bộ mực nước hạ du:
# ?mode=sync-ttb&hours=72
# API phải:
# 1. gọi máy chủ nguồn hạ du;
# 2. chuẩn hóa Hội Khách, Ái Nghĩa;
# 3. upsert Supabase;
# 4. trả ok=true khi lưu thành công.
API_DOWNSTREAM_FORECAST="/api/downstream-forecast"


# ==============================================================================
# 08. FORECAST / MODEL SOURCES
# ==============================================================================

# [SOURCE] Model RF2Q V7.
MODEL_RF2Q_V7="rf2q_v7"

# [SOURCE] Ensemble high/fast.
MODEL_RF2Q_HIGH_FAST="rf2q_high_fast"

# [SOURCE] Ensemble low/slow.
MODEL_RF2Q_LOW_SLOW="rf2q_low_slow"

# [SOURCE] Mixed thực đo + forecast mưa.
MODEL_RF2Q_MIXED="rf2q_mixed_real_fc"

# [SOURCE] AI V1.
MODEL_RF2Q_AI="rf2q_ai_v1"

# [SOURCE] HEC-HMS Lite SQL production.
MODEL_HEC_HMS_LITE="sql_hec_hms_lite"

# [SOURCE]
# Quy tắc HEC:
# - lịch sử: v_hec_lite_chart_history
# - hiện tại/tương lai: cycle mới nhất trong inflow_forecast_sql
# - ưu tiên model_version='v3.2'
# - cycle production ghi đè timestamp trùng lịch sử
HEC_MODEL_VERSION="v3.2"
HEC_HISTORY_LEAD_HOURS="4"
HEC_HISTORY_LAG_HOURS="4"
HEC_RUNOFF_BASE="2.1"
HEC_RECESSION_K="0.985"


# ==============================================================================
