FLOOD_MAP_DESIGN_FILE_ID="1jBnAZF0rU9AEiySrzcCVXkXnRb9mm7Fn"
FLOOD_MAP_CHECK_FILE_ID="1Iaj3p7CG1iJaAIRC6fN4G_cIvzhL-QLb"
FLOOD_MAP_DAM_BREAK_FILE_ID="1AV0D49QHsCgSNRKBmeFugOXp_8XFXeU1"


# ==============================================================================
# 15. PWA / SERVICE WORKER UPDATE POLICY
# ==============================================================================

# [SOURCE]
SERVICE_WORKER_ENABLED="true"

# [SOURCE]
# Browser phải kiểm tra SW qua network thay vì dùng cache cũ.
SERVICE_WORKER_UPDATE_VIA_CACHE="none"

# [SOURCE]
# PWA chủ động gọi reg.update() mỗi lần mở.
SERVICE_WORKER_AUTO_UPDATE_CHECK="true"

# [SOURCE]
# PWA gửi message SKIP_WAITING khi có worker mới.
SERVICE_WORKER_SKIP_WAITING="true"

# [SOURCE]
# Reload app khi controller service worker đổi.
SERVICE_WORKER_RELOAD_ON_CONTROLLER_CHANGE="true"

# [RECOMMENDED]
# service-worker.js nên hỗ trợ:
# self.addEventListener('message', e => {
#   if (e.data?.type === 'SKIP_WAITING') self.skipWaiting();
# });
SERVICE_WORKER_MESSAGE_HANDLER_REQUIRED="true"


# ==============================================================================
# 16. DATA FRESHNESS / CACHE RULES
# ==============================================================================

# [SOURCE]
# Các API mobile dùng cache:'no-store' ở fetch để ưu tiên dữ liệu mới.
API_FETCH_CACHE_MODE="no-store"

# [SOURCE]
# Monitoring RAM cache 2 phút.
CACHE_MONITORING_SECONDS="120"

# [SOURCE]
# Chat data RAM cache 30 giây.
CACHE_CHAT_SECONDS="30"

# [SOURCE]
# Rain mobile RAM cache 10 phút.
CACHE_RAIN_SECONDS="600"

# [RECOMMENDED]
# Dữ liệu vận hành sống không nên cache dài trong Service Worker.
SERVICE_WORKER_CACHE_OPERATIONAL_DATA="false"


# ==============================================================================
# 17. AUTHORIZATION / SECURITY
# ==============================================================================

# [SOURCE]
# API nội bộ mobile-overview/mobile-extra/mobile-monitoring/chat/downstream
# dùng Supabase access_token trong Authorization header.
API_AUTH_HEADER="Authorization"
API_AUTH_SCHEME="Bearer"
API_AUTH_SOURCE="Supabase session.access_token"

# [RECOMMENDED]
# Bật RLS cho toàn bộ bảng frontend truy cập.
SUPABASE_RLS_REQUIRED="true"

# [RECOMMENDED]
# Các API server phải xác minh JWT trước khi truy vấn dữ liệu nhạy cảm.
BACKEND_VERIFY_SUPABASE_JWT="true"

# [RECOMMENDED]
# Không expose service role, API key thời tiết, token đồng bộ hạ du.
PUBLIC_FRONTEND_SECRET_ALLOWED="false"

# [RECOMMENDED]
# Dùng HTTPS khi chạy PWA chính thức.
HTTPS_REQUIRED="true"


# ==============================================================================
# 18. DATA FLOW THEO CHỨC NĂNG
# ==============================================================================
#
# [A] ĐĂNG NHẬP
# User -> Supabase Auth -> session/access_token -> showApp()
#      -> usage_logs(email,user_agent)
#
# [B] TỔNG QUAN
# Ưu tiên:
# PWA -> GET /api/mobile-overview -> JSON -> renderMobileOverview()
# Nếu API lỗi:
# PWA -> Supabase reservoir_hourly_data/v_current_storage -> renderOverview()
#
# Sau đó:
# PWA -> GET /api/mobile-extra
#     -> hydrology_frequency
#     -> dead_level_forecast
#
# [C] BIỂU ĐỒ
# PWA -> Supabase:
# reservoir_hourly_data
# inflow_forecast
# inflow_forecast_sql
# v_hec_lite_chart_history
# rainfall_forecast
#
# [D] DỰ BÁO
# PWA -> bulletins
#
# [E] SỐ LIỆU
# PWA -> reservoir_hourly_data
#     -> 24h / 48h / 72h
#
# [F] HỒ LIÊN QUAN
# PWA -> GET /api/mobile-monitoring?hours=24|48|72
#     -> SONG_BUNG_4 / DAK_MI_4 / SONG_TRANH_2
#
# [G] HẠ DU
# Nút Cập nhật:
# PWA -> GET /api/downstream-forecast?mode=sync-ttb&hours=72
#     -> máy chủ hạ lưu
#     -> chuẩn hóa
#     -> upsert Supabase
#     -> ok=true
# sau đó:
# PWA -> /api/mobile-monitoring
#     -> Hội Khách / Ái Nghĩa
#
# [H] MƯA
# PWA -> /api/mobile-rain?source=openmeteo|openweather
#     -> 9 vị trí
#     -> 24h/48h/72h
#     -> Leaflet + OSM
#
# [I] CHATBOX
# PWA -> /api/mobile-chat-data
#     -> dữ liệu PWA đã tổng hợp
#     -> trả lời theo intent
#
# [J] AI BULLETIN
# PWA -> Supabase RPC generate_ai_operational_insight_v4
#     -> ai_bulletins
#
# [K] EXTERNAL VIEWER
# PWA iframe -> Windy / Google Drive / Google My Maps
# ==============================================================================


# ==============================================================================
# 19. BACKEND ENV - ĐỀ XUẤT CHUẨN HÓA
# ==============================================================================
# Những biến dưới đây là [RECOMMENDED], không thấy giá trị thật trong file PWA.
# Chúng nên đặt ở backend/hosting chứ không đưa vào index.html.
# ==============================================================================

BACKEND_SUPABASE_URL="${SUPABASE_URL}"
BACKEND_SUPABASE_SERVICE_ROLE_KEY="__SERVER_SECRET__"

OPENWEATHER_API_KEY="__SERVER_SECRET__"

# Nếu API downstream-forecast cần user/password/token nguồn hạ lưu:
DOWNSTREAM_SOURCE_URL="__SERVER_ONLY__"
DOWNSTREAM_SOURCE_USERNAME="__SERVER_SECRET__"
DOWNSTREAM_SOURCE_PASSWORD="__SERVER_SECRET__"
DOWNSTREAM_SOURCE_TOKEN="__SERVER_SECRET__"

# Nếu có scheduler đồng bộ định kỳ:
SYNC_DOWNSTREAM_CRON="__OPTIONAL__"
SYNC_RAIN_CRON="__OPTIONAL__"
SYNC_FORECAST_CRON="__OPTIONAL__"


# ==============================================================================
# 20. DEPLOYMENT CHECKLIST
# ==============================================================================
#
# 1. HTTPS hoạt động.
# 2. manifest.json hợp lệ.
# 3. service-worker.js được phục vụ cùng scope.
# 4. PWA_BUILD tăng sau mỗi release lớn.
# 5. RLS Supabase bật và test bằng anon/authenticated user.
